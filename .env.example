APP_NAME="Hostel Ease"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hostelease
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# NOTE: the hostelease_* prefix is lower-case on purpose — that is the exact name
# config/hostelease.php reads, and env names are CASE-SENSITIVE on the Linux host.
# An upper-cased copy of any key below is silently ignored (S0 · finding F5).
hostelease_DEFAULT_COUNTRY_CODE="+91"
hostelease_SESSION_TIMEOUT=30

DB_DUMP_BINARY=mysqldump

SUPERADMIN_NAME="Super Admin"
SUPERADMIN_MOBILE="9999999999"
SUPERADMIN_EMAIL="admin@satvscript.com"
SUPERADMIN_PASSWORD="password"

SETUP_TOKEN=

WHATSAPP_ENABLED=false
RAZORPAY_ENABLED=true
PAYU_ENABLED=false

VITE_APP_NAME="${APP_NAME}"

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Must match the Razorpay dashboard value EXACTLY. A mismatch returns 400 on
# every delivery, so money lands and nothing renews — and it fails silently.
RAZORPAY_WEBHOOK_SECRET=

# ── Operator payment links (S2) ────────────────────────────────────────
# Subscribe the dashboard webhook (POST /api/v1/webhooks/razorpay) to:
#   order.paid · payment.failed · refund.created · refund.processed ·
#   payment_link.paid · payment_link.expired · payment_link.cancelled
# An event that exists but is not subscribed fails silently.
# Link lifetime in days. Clamped into Razorpay's own window (min 15 minutes,
# max 6 months). A link that outlives the conversation that produced it is how
# a customer pays for a charge everyone has forgotten about.
SAAS_LINK_EXPIRY_DAYS=7
# Let Razorpay send the link and chase it. Each channel switches itself off when
# the owner has no address on file for it.
SAAS_LINK_NOTIFY_SMS=true
SAAS_LINK_NOTIFY_EMAIL=true
SAAS_LINK_REMINDERS=true

# ── Platform subscription billing ──────────────────────────────────────
# Per-branch list price (BRD decision D1: ₹10,000/yr · ₹1,000/mo — final).
hostelease_PRICE_YEARLY=10000
hostelease_PRICE_MONTHLY=1000
hostelease_TRIAL_DAYS=14
hostelease_GRACE_DAYS=3
# 'stack' (volume then manual, sequential) or 'greater' (best of the two).
hostelease_DISCOUNT_STACKING=stack
# Owner self-serve billing (online renewals / add-branch / branch creation).
# false = every mutating billing op is supervised via Super Admin → Account 360.
HOSTELEASE_OWNER_SELF_SERVE=false

# ── Platform (seller) identity on subscription receipts/invoices ───────
# The SAAS_* names are also read as fallbacks (see config/hostelease.php).
# Leave the GSTIN blank until registered: the PDF stays a RECEIPT and prints no
# tax line, and promotes itself to TAX INVOICE once this is filled.
SAAS_LEGAL_ENTITY="SatvScript"
SAAS_GST_NUMBER=
SAAS_SUPPORT_EMAIL=
SAAS_CONTACT_ADDRESS=
